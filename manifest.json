{
  "manifest_version": 3,
  "name": "ChatGPT Arrow Scroll",
  "version": "1.0",
  "description": "Use the up and down arrow keys to scroll ChatGPT chats.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}